# -----------------------------------------------------------------------------
# Stocky SaaS — example environment file
#
# Copy to .env, then run:  php artisan key:generate
# (the web installer at /setup writes most of these for you).
# NEVER commit or ship a real .env: it holds APP_KEY and credentials.
#
# Lines starting with "#" show optional settings with their built-in default.
# Leave them commented unless you need a different value: an EMPTY value
# (KEY=) is not the same as "unset" — it overrides the default with "".
# -----------------------------------------------------------------------------

APP_NAME="Stocky SaaS"
APP_ENV=production
# Generated by `php artisan key:generate` / the installer. Rotating it signs
# everyone out and invalidates encrypted values (backup credentials, tokens).
APP_KEY=
APP_DEBUG=false
# Full public URL of the CENTRAL app incl. scheme, e.g. https://app.example.com
# (tenants live on <sub>.example.com or their own custom domain).
APP_URL=http://localhost
# Scheduler/cron timezone, e.g. Asia/Riyadh, Africa/Casablanca, Europe/Paris
APP_TIMEZONE=UTC
# ASSET_URL=

# Central (super admin / landing) hosts, comma-separated. Default: the APP_URL
# host (and its www./bare variant). Every other host is treated as a tenant.
# CENTRAL_DOMAINS=

# The super admin account is chosen in the installer. These are only read by
# the CentralUsersSeeder when it is run by hand — leave them unset in
# production and never keep a password here.
# APP_SUPER_ADMIN_EMAIL=
# APP_SUPER_ADMIN_PASSWORD=

LOG_CHANNEL=stack
# LOG_SLACK_WEBHOOK_URL=
# LOG_STDERR_FORMATTER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# Reverse proxies allowed to set X-Forwarded-* (comma list, or * if the app is
# ONLY reachable through the proxy, e.g. Cloudflare / load balancer).
# Empty = trust nobody (login lockout uses the real client IP).
TRUSTED_PROXIES=

# --- Database (central) --------------------------------------------------------
# Tenant databases are created automatically by the same MySQL user, so it
# needs CREATE/DROP DATABASE rights — but should still not be root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_central
DB_USERNAME=saas_user
DB_PASSWORD=
# DB_COLLATION=utf8mb4_unicode_ci
# DATABASE_URL=
# MYSQL_ATTR_SSL_CA=
# Optional full path to mysqldump (backups)
# DUMP_PATH=mysqldump

# --- Cache / session / queue --------------------------------------------------
# BROADCAST_DRIVER=null
CACHE_DRIVER=file
# CACHE_PREFIX=          (default: derived from APP_NAME)
# FILESYSTEM_DRIVER=local
# FILESYSTEM_CLOUD=s3

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_DOMAIN=
# Set true when the app is ONLY reached over https (cookies then never travel
# over plain http).
# SESSION_SECURE_COOKIE=true
# SESSION_CONNECTION=
# SESSION_STORE=

# The jobs table lives in the central DB; run a worker (or the scheduler cron).
QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database
# Seconds before a running job is handed to another worker. Always kept above
# QUEUE_WORKER_TIMEOUT + 60 and 2060 (see config/queue.php).
# QUEUE_RETRY_AFTER=2100
# QUEUE_WORKER_TIMEOUT=1200

# REDIS_CLIENT=phpredis
# REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_CLUSTER=redis
# REDIS_PREFIX=          (default: derived from APP_NAME)
# REDIS_QUEUE=default

# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=

# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=
# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=

# BCRYPT_ROUNDS=10

# --- Tenancy / plans ------------------------------------------------------------
# TENANCY_TRIAL_DAYS=14
# TENANCY_EXPIRY_WARNING_DAYS=7
# Allow guests to preview landing templates (developer convenience)
# LANDING_TEMPLATE_PREVIEW_PUBLIC=false

# --- Mail ---------------------------------------------------------------------
# Platform SMTP is managed by the super admin (Settings → Mail); tenants
# configure their own in the app.
MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_LOG_CHANNEL=
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net
# POSTMARK_TOKEN=

# --- Passport (API auth) ------------------------------------------------------
# Keys normally live in storage/oauth-*.key (php artisan passport:keys).
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
# PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# --- Payments -----------------------------------------------------------------
# Gateway credentials are managed in the super admin / tenant settings.
# STRIPE_KEY=
# STRIPE_SECRET=
# FLUTTERWAVE_REDIRECT_URL=

# --- SMS gateways ---------------------------------------------------------------
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# NEXMO_KEY=
# NEXMO_SECRET=
# NEXMO_SIGNATURE_SECRET=
# NEXMO_PRIVATE_KEY=
# NEXMO_APPLICATION_ID=
# NEXMO_APP_NAME=NexmoLaravel
# NEXMO_APP_VERSION=1.1.2
# NEXMO_HTTP_CLIENT=
# TERMI_KEY=
# TERMI_SECRET=
# TERMI_SENDER=
# CUSTOM_SMS_API_URL=
# CUSTOM_SMS_METHOD=POST
# CUSTOM_SMS_CONTENT_TYPE=json
# CUSTOM_SMS_HEADERS=
# CUSTOM_SMS_PAYLOAD=
# CUSTOM_SMS_SENDER=
# CUSTOM_SMS_SUCCESS_KEYWORD=

# --- Cloud storage / backups (S3-compatible) ----------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# --- Realtime (Pusher) --------------------------------------------------------
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=

# --- Integrations -------------------------------------------------------------
# Mobile app minimum supported version
# MOBILE_MIN_APP_VERSION=1.0.0

# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_CALENDAR_REDIRECT_AFTER=

# ZATCA (Saudi e-invoicing) default environment: sandbox | simulation | production
# ZATCA_ENVIRONMENT=sandbox
# ZATCA_HTTP_TIMEOUT=30
# FBR (Pakistan e-invoicing)
# FBR_HTTP_TIMEOUT=30

# --- Webhooks -----------------------------------------------------------------
# Incoming webhooks (/api/webhooks/incoming/{source}) without a configured
# secret are refused unless this is true (only while integrating).
WEBHOOKS_ALLOW_UNSIGNED=false
# Wire secrets per source in config/webhooks.php (platform-wide), e.g.
# WEBHOOKS_INCOMING_SECRET_GENERIC=
# WEBHOOKS_INCOMING_SECRET_WOOCOMMERCE=
# WEBHOOKS_INCOMING_SECRET_QUICKBOOKS=

# --- WooCommerce sync (tuning; defaults are fine for most stores) -------------
# Developer only — sends every tenant's Woo API calls to this address.
# WOO_API_BASE_URL=
# WOO_TIMEOUT_MS_BATCH=30000
# WOO_MAX_PRODUCTS_PER_JOB=50
# WOO_MAX_STOCK_PRODUCTS_PER_JOB=100
# WOO_SYNC_STUCK_SECONDS=600
# WOO_SYNC_QUEUE_WAIT_SECONDS=1800
# WOO_HTTP_RETRIES=2
# WOO_HTTP_RETRY_BASE_MS=300
# WOO_MAX_CONSECUTIVE_FAILURES=7
# WOO_WP_MEDIA_SEARCH_TIMEOUT=15
# WOO_WP_MEDIA_UPLOAD_TIMEOUT=240
# WOO_WP_MEDIA_RETRIES=2
# WOO_WP_MEDIA_RETRY_SLEEP_MS=500
# WOO_POLL_TICK_MAX_SECONDS=300
# WOO_REMOTE_INDEX_TTL=900
# WOO_MAX_REMOTE_INDEX_PAGE_CAP=2000
# WOO_MAX_SKU_SEARCH_PAGE_CAP=50
# WOO_AUTOLINK_PAGE_CAP=200
# WOO_DELETE_VARIATIONS_PAGE_CAP=50
# WOO_VARIATIONS_LIST_PAGE_CAP=100
# WOO_PULL_VARIATIONS_PAGE_CAP=50
# WOO_PULL_STATS_PAGE_CAP=200
# WOO_PULL_ORDER_NOTES_MAX=25

# --- Accounting ---------------------------------------------------------------
# ACCOUNTING_V2_ENABLED=true
# ACCOUNTING_V2_AUTO_JOURNALS=false

# --- Platform licence / updater: leave commented (built-in values are used) ---
# UILIB_LICENSE_ENDPOINT=
# UILIB_GRACE_DAYS=14
# OPENSSL_CONF=
